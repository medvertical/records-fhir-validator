{
  "name": "@records-fhir/validation-types",
  "version": "0.1.12",
  "description": "Validation-domain types and runtime schemas, settings policies and fix suggestions for the Records FHIR validator. No database coupling.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/medvertical/records-fhir-validator.git",
    "directory": "packages/validation-types"
  },
  "homepage": "https://github.com/medvertical/records-fhir-validator/tree/main/packages/validation-types#readme",
  "keywords": [
    "fhir",
    "validation",
    "types",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fix-suggestions": {
      "types": "./dist/fix-suggestions.d.ts",
      "import": "./dist/fix-suggestions.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js"
    },
    "./validation/aspect-aliases": {
      "types": "./dist/validation/aspect-aliases.d.ts",
      "import": "./dist/validation/aspect-aliases.js"
    },
    "./validation/aspect-enums": {
      "types": "./dist/validation/aspect-enums.d.ts",
      "import": "./dist/validation/aspect-enums.js"
    },
    "./validation/enums": {
      "types": "./dist/validation/enums.d.ts",
      "import": "./dist/validation/enums.js"
    },
    "./validation/settings": {
      "types": "./dist/validation/settings.d.ts",
      "import": "./dist/validation/settings.js"
    },
    "./validation/settings-defaults": {
      "types": "./dist/validation/settings-defaults.d.ts",
      "import": "./dist/validation/settings-defaults.js"
    },
    "./validation/settings-schema": {
      "types": "./dist/validation/settings-schema.d.ts",
      "import": "./dist/validation/settings-schema.js"
    },
    "./validation/settings-types": {
      "types": "./dist/validation/settings-types.d.ts",
      "import": "./dist/validation/settings-types.js"
    },
    "./validation/structural-engines": {
      "types": "./dist/validation/structural-engines.d.ts",
      "import": "./dist/validation/structural-engines.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/run-typescript-native.mjs -p tsconfig.build.json",
    "typecheck": "node ../../scripts/run-typescript-native.mjs -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
